ARG PYTORCH_IMAGE_TAG=2.6.0-cuda12.4-cudnn9-runtime
FROM pytorch/pytorch:${PYTORCH_IMAGE_TAG}

# gptqmodel -> pypcre needs a C compiler (runtime image has none)
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ build-essential libpcre2-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade-strategy only-if-needed \
        "transformers[serving,sentencepiece]" \
        accelerate kernels triton openai-harmony gptqmodel pillow \
    && pip uninstall -y torchvision torchaudio
