FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

# python + compiler (autoawq / native wheels may need a toolchain)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        gcc g++ build-essential libpcre2-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

RUN pip install --no-cache-dir --upgrade pip setuptools wheel packaging

COPY requirements-pt.txt /tmp/requirements-pt.txt

# Primary index = PyTorch cu124 so torch/torchvision stay on matching CUDA wheels.
# PyPI is only the fallback for the rest of the pinned deps.
RUN pip install --no-cache-dir -r /tmp/requirements-pt.txt \
        --index-url https://download.pytorch.org/whl/cu124 \
        --extra-index-url https://pypi.org/simple \
    && python -c "import torch, torchvision; from torchvision.ops import nms; \
print(f'torch={torch.__version__} torchvision={torchvision.__version__} nms=ok')"
