FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# python + compiler (gptqmodel -> pypcre builds from source)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        gcc g++ build-essential libpcre2-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

# Install torch + torchvision together from the same CUDA 12.4 wheel index
# (avoids the broken conda torchvision in pytorch/pytorch runtime images).
RUN pip install --no-cache-dir \
        torch==2.6.0 torchvision==0.21.0 \
        --index-url https://download.pytorch.org/whl/cu124 \
    && pip install --no-cache-dir \
        "transformers[serving,sentencepiece]" \
        accelerate kernels triton openai-harmony gptqmodel pillow
