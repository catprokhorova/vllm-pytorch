# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# Docker Compose loads .env automatically for variable substitution.

# ------------------------------------------------------------------------------
# Shared (both vLLM and PyTorch compose files)
# ------------------------------------------------------------------------------

# Hugging Face token (required for openai/gpt-oss-20b)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Model and server
MODEL=openai/gpt-oss-20b
HOST=0.0.0.0
PORT=8000
DTYPE=auto
TRUST_REMOTE_CODE=true

# ------------------------------------------------------------------------------
# vLLM only (vllm-docker-compose.yml)
# ------------------------------------------------------------------------------

SERVED_MODEL_NAME=openai/gpt-oss-20b

# GPU parallelism and memory
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.9
MAX_NUM_BATCHED_TOKENS=16384
MAX_NUM_SEQS=64
MAX_MODEL_LEN=32768
ASYNC_SCHEDULING=false

# Tool calling (gpt-oss)
TOOL_CALL_PARSER=openai
ENABLE_AUTO_TOOL_CHOICE=true

# Non-Hopper GPUs (e.g. RTX 4090/3090): uncomment if you hit attention kernel errors
# VLLM_ATTENTION_BACKEND=TRITON_ATTN_VLLM_V1

# vLLM image tag (gptoss recommended for gpt-oss models)
VLLM_IMAGE_TAG=gptoss

# ------------------------------------------------------------------------------
# PyTorch only (pt-docker-compose.yml)
# ------------------------------------------------------------------------------

PYTORCH_IMAGE_TAG=2.6.0-cuda12.4-cudnn9-runtime
DEVICE=cuda:0
CONTINUOUS_BATCHING=false

# ------------------------------------------------------------------------------
# Benchmark client (main.py) — optional, passed via CLI flags
# ------------------------------------------------------------------------------

# BASE_URL=http://localhost:8000/v1
# MAX_TOKENS=256
