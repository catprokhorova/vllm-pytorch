# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# Docker Compose loads .env automatically for variable substitution.

# ------------------------------------------------------------------------------
# Shared (both vLLM and PyTorch compose files)
# ------------------------------------------------------------------------------

# Hugging Face token (required for openai/gpt-oss-20b)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Model and server
MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
HOST=0.0.0.0
PORT=8000
DTYPE=auto
TRUST_REMOTE_CODE=true

# ------------------------------------------------------------------------------
# vLLM only (vllm-docker-compose.yml)
# ------------------------------------------------------------------------------

API_KEY=***
MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-AWQ
MODEL_NUM_CTX=4096
GPU_UTILIZE=0.9
KV_CACHE_DTYPE=auto

# ------------------------------------------------------------------------------
# PyTorch only (pt-docker-compose.yml)
# ------------------------------------------------------------------------------

PYTORCH_IMAGE_TAG=2.6.0-cuda12.4-cudnn9-runtime
DEVICE=cuda:0
CONTINUOUS_BATCHING=false

# ------------------------------------------------------------------------------
# Benchmark client (main.py) — optional, passed via CLI flags
# ------------------------------------------------------------------------------

# BASE_URL=http://localhost:8000/v1
# MAX_TOKENS=256
