# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# Docker Compose loads .env automatically for variable substitution.

# ------------------------------------------------------------------------------
# Shared (both vLLM and PyTorch compose files)
# ------------------------------------------------------------------------------

# Hugging Face token for gated/private models (leave empty if not required)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Model and server
MODEL=Qwen/Qwen2.5-7B-Instruct
HOST=0.0.0.0
PORT=8000
DTYPE=bfloat16
TRUST_REMOTE_CODE=true

# ------------------------------------------------------------------------------
# vLLM only (vllm-docker-compose.yml)
# ------------------------------------------------------------------------------

SERVED_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# CPU backend (see https://docs.vllm.ai/en/stable/getting_started/installation/cpu/)
VLLM_TARGET_DEVICE=cpu
VLLM_CPU_KVCACHE_SPACE=16
VLLM_CPU_OMP_THREADS_BIND=auto
VLLM_CPU_NUM_OF_RESERVED_CPU=1

# Parallelism and memory (gpu-memory-utilization sets RAM fraction on CPU)
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.8
MAX_NUM_BATCHED_TOKENS=16384
MAX_NUM_SEQS=64
ASYNC_SCHEDULING=false

# vLLM image tag: latest-x86_64 (Intel/AMD) or latest-arm64 (Apple Silicon)
VLLM_IMAGE_TAG=latest-x86_64

# ------------------------------------------------------------------------------
# PyTorch only (pt-docker-compose.yml)
# ------------------------------------------------------------------------------

DEVICE=cpu
OMP_NUM_THREADS=auto
CONTINUOUS_BATCHING=false

# ------------------------------------------------------------------------------
# Benchmark client (main.py) — optional, passed via CLI flags
# ------------------------------------------------------------------------------

# BASE_URL=http://localhost:8000/v1
# MAX_TOKENS=256
