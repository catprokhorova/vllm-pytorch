# Copy to .env before deployment (never commit .env):
#   cp .env.example .env
# Before every update keep a rollback copy:
#   cp .env .env.previous
#
# All versions are pinned on purpose: image tags, model revision and config.
# No "latest" anywhere — that is what makes rollback a two-line operation.

# ------------------------------------------------------------------------------
# Model serving (vLLM)
# ------------------------------------------------------------------------------

VLLM_TAG=v0.34.0
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct-AWQ
MODEL_REVISION=3ecffa0ceb27851800f45519bab9c457a04405e1

# Server-side key. Internal only: vLLM port is NOT published, gateway is the
# single public entrypoint.
VLLM_API_KEY=change-me-vllm

# ------------------------------------------------------------------------------
# LiteLLM gateway
# ------------------------------------------------------------------------------

LITELLM_TAG=v1.108.15-lts

# Master key: admin only, used to issue virtual keys (see keys.sh).
LITELLM_MASTER_KEY=change-me-master

# Postgres credentials for virtual keys / spend tracking
PG_PASSWORD=change-me-pg

# ------------------------------------------------------------------------------
# Reserve model (Ollama, runs on CPU — 4GB VRAM cannot host two engines)
# ------------------------------------------------------------------------------

OLLAMA_TAG=0.40.17
RESERVE_MODEL=qwen2.5:0.5b
